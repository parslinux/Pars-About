[Desktop Entry]
Name=Pars Hardware Information
Name[tr]=Pars Donanım Bilgisi
GenericName=Hardware Information Viewer
GenericName[tr]=Donanım Bilgisi Görüntüleyici
Comment=Get informations about the hardware in your Pars system.
Comment[tr]=Pars sisteminizdeki donanımlar hakkında bilgi edinin.
Exec=pars-about --hardware
Icon=pars-hardware-info
Terminal=false
Type=Application
Categories=Settings;X-XFCE-SettingsDialog;X-Pars-Apps;
StartupNotify=true
Keywords=about;info;system;hardware;
Keywords[pt]=sobre;informação;sistema;
Keywords[tr]=hakkında;bilgi;sistem;donanım;
